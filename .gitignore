__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
*.manifest
*.spec

# Virtual environment
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment / secrets
.env
.env.local
.env.*.local
# JSON 主配置与 web 受控写面落点（2026-10-28 起配置从 .env 换成 config/agent.json）。
# 装着与 .env 同一批凭据（LLM_API_KEY / 协议端 token / QQ 号），同纪律绝不入库；
# 它们是 compose init 在项目目录生成的普通文件，不再是 dotfile，.env 条目盖不住
config/agent.json
config/agent.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Node (if any scripts added later)
node_modules/
package-lock.json
yarn.lock

# Database volumes / local data
pgdata/
data/sessions/
data/cache/
# 聊天记录归档与数据库备份：含隐私内容，绝不入库
data/archive/
data/backups/
# 旧版多 LLM provider 配置（含 API key）。2026-10-28 起 provider 已并进
# config/agent.json 的 LLM_PROVIDERS 数组；此文件仅在从旧版升级时做一次性迁移读取。
data/llm-providers.json
# 多搜索源配置（含 API key），运行期生成，绝不入库
data/search-providers.json
# 主动联系配置（含目标 QQ 号）与热点候选池状态，运行期生成，绝不入库
data/nudge.json
data/nudge-hotspot.json
# 2FA secret（TOTP 密钥），运行期生成，绝不入库
data/2fa-secret.json
# 重启回执与定时推送去重状态（含真实 QQ/群号），运行期生成，绝不入库
data/reboot-notice.json
data/push-state.json

# compose 部署把上面这批 data/ 根状态文件**重定向**进 data/state/
# （scripts/compose_init.py 的 STATE_REDIRECTS），该目录本身也在 DATA_DIRS 里。
# 整目录忽略而不是逐个补：2026-10-28 做重定向时只补了 llm-providers.json 一行，
# 另外 6 个（2fa-secret / search-providers / nudge / nudge-hotspot /
# reboot-notice / push-state）连同下面两个目录全漏，compose/NAS 机器上
# `git add -A` 会把 TOTP secret、搜索源 key 与真实 QQ 目标暂存进公开仓库。
# 覆盖集合由 tests/test_repo_guards.py 从 STATE_REDIRECTS / DATA_DIRS 推导断言，
# 新增状态文件不用再想起来补这一行。
data/state/
# 异地备份镜像暂存（pg_dump 明文，可达数 GB）与 SSH 只读诊断的 known_hosts/hosts
data/mirror/
data/ssh/

# 人格：只跟踪仓库内置（assistant / fortune_teller），本地自定义一律不入库
agentcore/personas/*.md
!agentcore/personas/assistant.md
!agentcore/personas/fortune_teller.md

# 个人脱敏词表与真实标识清单（实际出现的人名/昵称/QQ 号/群号），含隐私，不入库。
# 例外：隐私门禁的块名单只存 SHA-256（scripts/check_privacy.py 读取），必须随仓库走——
# 门禁自己要能拦住「下次又提交真实值」，而它自己不能成为新的泄漏点。
data/privacy/*
!data/privacy/id-hashes.txt

# 成本用量账本与运行日志（含聊天明文，绝不入库）
data/budget/
data/logs/

# LLM 沙箱工作区（本地临时/缓存）：整目录运行期，一律不入库。
# 2026-10-29 起人格（data/personas）与定时任务（data/cron）已搬出沙箱写面，
# workspace 里不再有需要入库的「配置」。
data/workspace/*

# 人格目录：运行时配置，真实人格（可能含个人化正文）只写本机。
# 默认人格模板在 agentcore/personas/templates/SOUL.md（随镜像/仓库走）。
data/personas/*

# 定时任务：运行时配置 + 运行状态 sidecar。模板见 docs/examples/cron-jobs.example.json。
# 纪律：jobs.json 里的真实群号/QQ 号只写本机；scripts/check_privacy.py 是 CI 门禁。
data/cron/*

# 知识库样例语料（本地自备，一律不入库）
data/kb_samples/*
!data/kb_samples/.gitkeep

# Mimosa 安全钩子的本地扫描状态（工具自产，不入库）
.mimosa/

# 本机工具产物（不属于项目内容）：DSH 的计划/会话目录里可能留存真实标识的明文副本，
# 一律不入库；jieba 词典缓存与 pytest 临时根同理。
.stepcode/
pytest-of_*/
pytest-of-*/
jieba.cache
